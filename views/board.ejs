<%- include('partials/header', { title: 'Board', active: 'board' }) %>

<h1>Board</h1>
<p class="intro">A simple open board for short posts. No account needed.</p>

<section class="section">
  <h2>Write a post</h2>

  <% if (error) { %>
    <p class="alert" role="alert"><%= error %></p>
  <% } %>

  <form method="post" action="/posts">
    <label>Title
      <input name="title" maxlength="120" required value="<%= values.title || '' %>">
    </label>
    <label>Your name
      <input name="author" maxlength="40" required value="<%= values.author || '' %>">
    </label>
    <label>Message
      <textarea name="body" maxlength="2000" required><%= values.body || '' %></textarea>
    </label>

    <button class="btn" type="submit">Post</button>
  </form>
</section>

<section class="section">
  <h2>Posts</h2>

  <% if (posts.length === 0) { %>
    <p class="muted">No posts yet. Write the first one above.</p>
  <% } else { %>
    <% posts.forEach((post) => { %>
      <article class="post">
        <h3><a href="/posts/<%= post.id %>"><%= post.title %></a></h3>
        <p class="meta">by <strong><%= post.author %></strong> on <time datetime="<%= post.created_at.toISOString() %>"><%= formatDate(post.created_at) %></time></p>
        <p class="excerpt"><%= excerpt(post.body) %></p>
        <p class="meta"><a href="/posts/<%= post.id %>#comments"><%= post.comment_count %> <%= post.comment_count === 1 ? 'comment' : 'comments' %></a></p>
      </article>
    <% }) %>
  <% } %>
</section>

<%- include('partials/footer') %>
